#!/bin/sh
set -u

OUT=${TC_DASHBOARD_OUT:-${TMPDIR:-/tmp}/tinycloud-dashboard.html}
HOST=${TC_DASHBOARD_HOST:-}
OPEN=true
WATCH=false
WEB=false
VIEW=
INTERVAL=${TC_DASHBOARD_INTERVAL:-60}

usage() {
  echo "usage: tinycloud-dashboard [--watch] [--web [--no-open] [--out FILE]] [USER@]GATEWAY"
}

parse_args() {
  while [ $# -gt 0 ]; do
    case $1 in
      --no-open)
        OPEN=false
        shift
        ;;
      --web)
        WEB=true
        shift
        ;;
      --watch)
        WATCH=true
        shift
        ;;
      --out)
        [ $# -ge 2 ] || { usage >&2; return 1; }
        OUT=$2
        shift 2
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        usage >&2
        return 1
        ;;
      *)
        HOST=$1
        shift
        ;;
    esac
  done
  if [ -z "$HOST" ]; then
    usage >&2
    return 1
  fi
  if ! printf '%s' "$HOST" | grep -Eq '^[A-Za-z0-9._@:-]+$'; then
    echo "That is not a valid host." >&2
    return 1
  fi
}

fetch_view() {
  ssh -o ConnectTimeout=10 "$HOST" tinycloud-gw view
}

write_page() {
  cat << 'EOT'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
EOT
  if [ "$WATCH" = true ]; then
    printf '<meta http-equiv="refresh" content="%s">\n' "$INTERVAL"
  fi
  cat << 'EOT'
<title>TinyCloud</title>
<style>
:root{color-scheme:light dark;--bg:#fff;--fg:#1a1a1a;--muted:#666;--line:#e2e2e2;--ok:#1a7f37;--bad:#cf222e;--warn:#9a6700;--bar:#0969da;--barbg:#e6e6e6}
@media (prefers-color-scheme:dark){:root{--bg:#111;--fg:#eee;--muted:#999;--line:#2c2c2c;--ok:#3fb950;--bad:#f85149;--warn:#d29922;--bar:#58a6ff;--barbg:#2c2c2c}}
body{margin:0;padding:2rem 1.25rem;background:var(--bg);color:var(--fg);font:15px/1.45 system-ui,sans-serif}
main{max-width:60rem;margin:0 auto}
h1{font-size:1.4rem;margin:0 0 .25rem}
.sub{color:var(--muted);margin:0 0 1.5rem}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:.55rem .6rem;border-bottom:1px solid var(--line);vertical-align:middle}
th{font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);font-weight:600}
.ok{color:var(--ok)}.bad{color:var(--bad)}.warn{color:var(--warn)}.muted{color:var(--muted)}
.dot{display:inline-block;width:.6rem;height:.6rem;border-radius:50%;margin-right:.45rem;background:currentColor}
.bar{display:inline-block;width:5rem;height:.45rem;border-radius:.25rem;background:var(--barbg);vertical-align:middle;margin-right:.5rem;overflow:hidden}
.bar>span{display:block;height:100%;background:var(--bar)}
.flags span{display:inline-block;margin-right:.5rem}
.empty{padding:2rem 0;color:var(--muted)}
@media (max-width:640px){.hide{display:none}}
</style>
</head>
<body>
<main>
<h1>TinyCloud</h1>
<p class="sub" id="sub"></p>
<div id="out"></div>
</main>
<script id="data" type="application/json">
EOT
  fetch_data_escaped
  cat << 'EOT'
</script>
<script>
const data = JSON.parse(document.getElementById('data').textContent);
const STALE_MS = 36 * 3600 * 1000;
function el(tag, text, cls) {
  const e = document.createElement(tag);
  if (text !== undefined) e.textContent = text;
  if (cls) e.className = cls;
  return e;
}
function gb(b) {
  return typeof b === 'number' ? (b / 1073741824).toFixed(1) + ' GB' : '?';
}
function ago(iso) {
  const t = Date.parse(iso);
  if (isNaN(t)) return '?';
  const m = Math.max(0, Math.round((Date.now() - t) / 60000));
  if (m < 1) return 'just now';
  if (m < 60) return m + ' min ago';
  const h = Math.round(m / 60);
  if (h < 48) return h + ' hr ago';
  return Math.round(h / 24) + ' days ago';
}
function dur(iso) {
  const t = Date.parse(iso);
  if (isNaN(t)) return '-';
  const m = Math.round((Date.now() - t) / 60000);
  if (m < 0) return '-';
  if (m < 60) return Math.max(1, m) + ' min';
  const h = Math.round(m / 60);
  if (h < 48) return h + ' hr';
  return Math.round(h / 24) + ' days';
}
function clock(iso) {
  const t = new Date(iso);
  if (isNaN(t)) return '';
  return t.toLocaleString([], {month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true});
}
function flags(n) {
  const list = [];
  const s = n.status;
  if (n.online === false) list.push(['Offline', 'bad']);
  if (!s) {
    list.push(['No status yet', 'warn']);
    return list;
  }
  if (s.low_space) list.push(['Low space', 'bad']);
  if (s.case_conflicts > 0) list.push([s.case_conflicts + ' name conflict' + (s.case_conflicts === 1 ? '' : 's'), 'warn']);
  if (s.reboot_required) list.push(['Reboot needed', 'warn']);
  if (Date.now() - Date.parse(s.reported) > STALE_MS) list.push(['Stale status', 'warn']);
  return list;
}
function render() {
  const nodes = Array.isArray(data.nodes) ? data.nodes.slice() : [];
  nodes.sort((a, b) => String(a.owner).localeCompare(String(b.owner)) || String(a.name).localeCompare(String(b.name)));
  const online = nodes.filter(n => n.online === true).length;
  const problems = nodes.filter(n => flags(n).length > 0).length;
  document.getElementById('sub').textContent =
    nodes.length + ' node' + (nodes.length === 1 ? '' : 's') + ', ' + online + ' online, ' +
    problems + ' with warnings. Updated ' + clock(data.generated) + '.';
  const out = document.getElementById('out');
  if (nodes.length === 0) {
    out.appendChild(el('p', 'No nodes yet.', 'empty'));
    return;
  }
  const table = el('table');
  const head = el('tr');
  ['Node', 'Owner', 'Role', 'State', 'Uptime', 'Stored', 'Free', 'Version', 'Last status change', 'Warnings'].forEach((h, i) => {
    const th = el('th', h);
    if (i === 2 || i === 7) th.className = 'hide';
    head.appendChild(th);
  });
  table.appendChild(head);
  nodes.forEach(n => {
    const s = n.status;
    const tr = el('tr');
    tr.appendChild(el('td', String(n.name)));
    tr.appendChild(el('td', String(n.owner)));
    tr.appendChild(el('td', String(n.role), 'hide'));
    const state = el('td');
    const label = n.online === true ? 'Online' : n.online === false ? 'Offline' : 'Unknown';
    const cls = n.online === true ? 'ok' : n.online === false ? 'bad' : 'warn';
    const wrap = el('span', undefined, cls);
    wrap.appendChild(el('span', undefined, 'dot'));
    wrap.appendChild(document.createTextNode(label));
    state.appendChild(wrap);
    tr.appendChild(state);
    const up = n.online !== false && s && s.booted ? dur(s.booted) : '-';
    tr.appendChild(el('td', up));
    const stored = el('td');
    if (s) {
      const bar = el('span', undefined, 'bar');
      const fill = el('span');
      fill.style.width = Math.max(0, Math.min(100, Number(s.percent_stored))) + '%';
      bar.appendChild(fill);
      stored.appendChild(bar);
      stored.appendChild(document.createTextNode(s.percent_stored + '%'));
    } else {
      stored.appendChild(el('span', '?', 'muted'));
    }
    tr.appendChild(stored);
    tr.appendChild(el('td', s ? gb(s.free_bytes) : '?'));
    tr.appendChild(el('td', s ? String(s.version) : '?', 'hide'));
    const rep = el('td', s ? ago(s.reported) : '?');
    if (s) rep.title = clock(s.reported);
    tr.appendChild(rep);
    const fl = el('td', undefined, 'flags');
    flags(n).forEach(f => fl.appendChild(el('span', f[0], f[1])));
    tr.appendChild(fl);
    table.appendChild(tr);
  });
  out.appendChild(table);
}
render();
</script>
</body>
</html>
EOT
}

fetch_data_escaped() {
  printf '%s\n' "$VIEW" | sed 's/</\\u003c/g'
}

open_page() {
  if [ "$OPEN" != true ]; then
    return 0
  fi
  if command -v open > /dev/null 2>&1; then
    open "$1"
  elif command -v xdg-open > /dev/null 2>&1; then
    xdg-open "$1" > /dev/null 2>&1
  fi
}

load_view() {
  VIEW=$(fetch_view) || return 1
  case $VIEW in
    '{"version":1,'*) return 0 ;;
  esac
  return 2
}

save_page() {
  (umask 077 && write_page > "$OUT.tmp" && mv "$OUT.tmp" "$OUT")
}

watch_loop() {
  while true; do
    sleep "$INTERVAL"
    if load_view; then
      save_page || echo "Could not write $OUT" >&2
    else
      echo "Could not refresh, will try again." >&2
    fi
  done
}

fetch_text() {
  if [ -t 1 ]; then
    ssh -o ConnectTimeout=10 "$HOST" tinycloud-gw status --color
  else
    ssh -o ConnectTimeout=10 "$HOST" tinycloud-gw status
  fi
}

load_text() {
  TEXT=$(fetch_text)
  lt_rc=$?
  if [ "$lt_rc" -eq 255 ]; then
    return 1
  fi
  [ "$lt_rc" -eq 0 ] || return 2
  return 0
}

explain_failure() {
  case $1 in
    1) echo "Could not read the status from $HOST. Check that you can ssh to it." >&2 ;;
    *) echo "The gateway did not return a status. Is tinycloud-gw up to date there?" >&2 ;;
  esac
}

show_text() {
  if [ "$WATCH" = true ]; then
    printf '\033[H\033[2J'
  fi
  printf '%s\n' "$TEXT"
  if [ "$WATCH" = true ]; then
    printf '\nRefreshing every %s seconds. Press Ctrl+C to stop.\n' "$INTERVAL"
  fi
}

text_loop() {
  while true; do
    sleep "$INTERVAL"
    if load_text; then
      show_text
    else
      echo "Could not refresh, will try again." >&2
    fi
  done
}

main_text() {
  load_text
  mt_rc=$?
  if [ "$mt_rc" -ne 0 ]; then
    explain_failure "$mt_rc"
    return 1
  fi
  show_text
  if [ "$WATCH" = true ]; then
    text_loop
  fi
}

main() {
  parse_args "$@" || return 1
  if [ "$WEB" != true ]; then
    main_text
    return $?
  fi
  load_view
  case $? in
    0) ;;
    1)
      echo "Could not read the view from $HOST. Check that you can ssh to it." >&2
      return 1
      ;;
    *)
      echo "The gateway did not return a status view. Is tinycloud-gw up to date there?" >&2
      return 1
      ;;
  esac
  save_page || return 1
  echo "Wrote $OUT"
  open_page "$OUT"
  if [ "$WATCH" = true ]; then
    echo "Refreshing every $INTERVAL seconds. Press Ctrl+C to stop."
    watch_loop
  fi
}

if [ "${DASH_NO_MAIN:-}" != 1 ]; then
  main "$@"
fi

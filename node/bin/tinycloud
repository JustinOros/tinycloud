#!/bin/sh
TC_HOME=${TC_HOME:-$(cd "$(dirname "$(readlink -f "$0" 2> /dev/null || echo "$0")")/.." && pwd)}

dc() {
  docker compose --project-directory "$TC_HOME" "$@"
}

agent_run() {
  ar_script=$1
  shift
  dc exec -T agent sh "/app/agent/$ar_script.sh" "$@"
}

conf_file() {
  for cf_path in "$TC_HOME/tinycloud.conf" /etc/tinycloud/node.env; do
    if [ -r "$cf_path" ]; then
      printf '%s' "$cf_path"
      return 0
    fi
  done
  return 1
}

conf_value() {
  cv_file=$(conf_file) || return 0
  sed -n "s/^$1=//p" "$cv_file" | tail -n 1 | tr -d '\r'
}

to_epoch() {
  date -u -d "$1" +%s 2> /dev/null || TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2> /dev/null
}

fmt_epoch() {
  date -d "@$1" '+%Y-%m-%d %I:%M:%S %p' 2> /dev/null || date -r "$1" '+%Y-%m-%d %I:%M:%S %p'
}

localize_line() {
  ll_first=${1%% *}
  ll_rest=${1#* }
  ll_iso=
  ll_tail=
  case $ll_first in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z)
      ll_iso=$ll_first
      ll_tail=$ll_rest
      ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
      ll_second=${ll_rest%% *}
      case $ll_second in
        [0-9][0-9]:[0-9][0-9]:[0-9][0-9])
          ll_iso="${ll_first}T${ll_second}Z"
          ll_tail=${ll_rest#* }
          ;;
      esac
      ;;
  esac
  if [ -z "$ll_iso" ]; then
    printf '%s\n' "$1"
    return 0
  fi
  if ll_epoch=$(to_epoch "$ll_iso") && ll_new=$(fmt_epoch "$ll_epoch"); then
    printf '%s %s\n' "$ll_new" "$ll_tail"
  else
    printf '%s\n' "$1"
  fi
}

localize_stream() {
  while IFS= read -r ls_line; do
    localize_line "$ls_line"
  done
}

scrub() {
  sc_token=$(conf_value RELAY_TOKEN)
  if [ -n "$sc_token" ] && printf '%s' "$sc_token" | grep -Eq '^[A-Za-z0-9_-]{1,128}$'; then
    sed -E -e "s/$sc_token/REDACTED/g" -e 's/[0-9]{1,3}(\.[0-9]{1,3}){3}/x.x.x.x/g' \
      -e 's/([0-9A-Fa-f]{1,4}:){3,7}[0-9A-Fa-f]{1,4}/x:x:x:x/g'
  else
    sed -E -e 's/[0-9]{1,3}(\.[0-9]{1,3}){3}/x.x.x.x/g' \
      -e 's/([0-9A-Fa-f]{1,4}:){3,7}[0-9A-Fa-f]{1,4}/x:x:x:x/g'
  fi
}

redact_conf() {
  if cr_file=$(conf_file); then
    sed -E 's/^(RELAY_TOKEN|WIFI_PASSWORD|WIFI_SSID)=.*/\1=REDACTED/' "$cr_file"
  else
    echo "no config file found"
  fi
}

cmd_logs() {
  cl_component=${1:-agent}
  case $cl_component in
    agent|syncthing|web) ;;
    *)
      echo "usage: tinycloud logs [agent|syncthing|web]" >&2
      return 2
      ;;
  esac
  dc logs --no-log-prefix --tail "${TC_LOG_LINES:-200}" "$cl_component" 2>&1 | localize_stream
}

cmd_debug() {
  case ${1:-} in
    on|off) agent_run debug "$1" ;;
    *)
      echo "usage: tinycloud debug on|off" >&2
      return 2
      ;;
  esac
}

cmd_support() {
  cs_out=${TC_SUPPORT_OUT:-tinycloud-support-$(date +%Y%m%d-%H%M%S).txt}
  {
    echo "TinyCloud support bundle"
    echo "version: $(cat "$TC_HOME/VERSION" 2> /dev/null || echo unknown)"
    echo "== doctor =="
    agent_run doctor 2>&1
    echo "== config =="
    redact_conf
    echo "== agent log =="
    dc logs --no-log-prefix --tail 500 agent 2>&1
    echo "== syncthing log =="
    dc logs --no-log-prefix --tail 500 syncthing 2>&1
  } | scrub > "$cs_out"
  echo "Wrote $cs_out"
  echo "Open it, look it over, then paste it to the person helping you."
}

cmd_leave() {
  printf 'Leave the cloud? Files stay on this machine. Type yes to continue: '
  read -r cl_answer
  if [ "$cl_answer" != yes ]; then
    echo "Cancelled."
    return 1
  fi
  cl_name=$(conf_value NODE_NAME)
  agent_run leave || return 1
  dc stop agent
  echo "You left the cloud."
  if [ -n "$cl_name" ]; then
    echo "Tell the cloud owner to run: tinycloud remove $cl_name"
  fi
}

cmd_confirm() {
  agent_run confirm "$@" || return 1
  if [ "$#" -gt 0 ]; then
    agent_run apply-peers
  fi
}

usage() {
  cat << EOF
usage: tinycloud COMMAND

  doctor            check that this node is healthy
  logs [NAME]       show recent logs (agent, syncthing, web)
  debug on|off      extra Syncthing logging for 30 minutes
  support           write one text file to paste when asking for help
  confirm [NAME]    list or confirm new peers (PEERS_CONFIRM=manual)
  leave             leave the cloud, files stay here
  version           show the version
EOF
}

main() {
  cmd=${1:-}
  [ "$#" -gt 0 ] && shift
  case $cmd in
    doctor) agent_run doctor ;;
    logs) cmd_logs "$@" ;;
    debug) cmd_debug "$@" ;;
    support) cmd_support ;;
    confirm) cmd_confirm "$@" ;;
    leave) cmd_leave ;;
    version) cat "$TC_HOME/VERSION" ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

if [ "${TC_SOURCED:-0}" != 1 ]; then
  main "$@"
fi

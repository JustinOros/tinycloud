#!/bin/sh
GW_HOME=${GW_HOME:-/opt/tinycloud-gateway}
GW_LIB_DIR=${GW_LIB_DIR:-$GW_HOME}
. "$GW_LIB_DIR/lib.sh"
. "$GW_LIB_DIR/alerts.sh"
. "$GW_LIB_DIR/link.sh"

GW_STATE=$GW_HOME/state
APPROVED=$GW_STATE/approved.json
LINKS=$GW_STATE/links.json
AUDIT=$GW_HOME/audit.log
FOLDERS_DIR=$GW_HOME/data/syncthing
BACKUP_DIR=${GW_BACKUP_DIR:-/root/tinycloud-backup}
GW_VERSION=$(cat "$GW_LIB_DIR/VERSION" 2> /dev/null || echo unknown)
ASSUME_YES=0

usage() {
  cat <<EOT
usage: tinycloud-gw COMMAND

  approve NAME DEVICEID ROLE OWNER [--yes]   add a node
  remove NAME [--yes]                        remove a node
  list                                       show nodes and who is online
  link export                                print a code that links another cloud to this one
  link add NAME CODE [--accept O,..] [--offer O,..] [--yes]
                                             link a cloud, or update a link
  link list                                  show linked clouds
  link remove NAME [--yes]                   unlink a cloud
  config                                     show the lines every node needs
  aggregate                                  rebuild the status views
  view                                       print the full status view as JSON
  status [--watch]                           print a table of nodes, --watch keeps it updating
  alert [show|set NAME VALUE|test]           show, change, or test alerts
  backup                                     save the gateway identity (a timer also does it weekly)
  restore FILE [--yes]                       restore a saved identity
  rotate-token [--yes]                       make a new relay token
  version

alert settings: url DISCORD-WEBHOOK|off, heartbeat ADDRESS|off, reminder 9am|off, recovered yes|no,
                offline, no-status, low-space, conflicts, reboot, gateway-reboot (times like 5m, 60m, 2h, 1d)
EOT
}

audit() {
  au_line="$(date -u +%Y-%m-%dT%H:%M:%SZ) $(printf '%s' "$*" | LC_ALL=C tr -c ' -~' '?')"
  mkdir -p "$GW_HOME"
  if [ -f "$AUDIT" ] && [ "$(wc -c < "$AUDIT")" -gt 1048576 ]; then
    mv "$AUDIT" "$AUDIT.1"
  fi
  printf '%s\n' "$au_line" >> "$AUDIT"
}

require_root() {
  if [ "${GW_ALLOW_NONROOT:-0}" != 1 ] && [ "$(id -u)" -ne 0 ]; then
    log ERROR "run as root"
    return 1
  fi
}

lock() {
  mkdir -p "$GW_STATE"
  if mkdir "$GW_STATE/.lock" 2> /dev/null; then
    printf '%s' "$$" > "$GW_STATE/.lock/pid"
    return 0
  fi
  lk_pid=$(cat "$GW_STATE/.lock/pid" 2> /dev/null || true)
  if [ -n "$lk_pid" ] && ! kill -0 "$lk_pid" 2> /dev/null; then
    rm -rf "$GW_STATE/.lock"
    lock
    return $?
  fi
  log ERROR "another tinycloud-gw command is running"
  return 1
}

unlock() {
  rm -rf "$GW_STATE/.lock"
}

locked() {
  lock || return 1
  "$@"
  lc_rc=$?
  unlock
  return $lc_rc
}

confirm() {
  if [ "$ASSUME_YES" = 1 ]; then
    return 0
  fi
  printf 'Type yes to continue: '
  read -r cf_answer || return 1
  [ "$cf_answer" = yes ]
}

dc() {
  docker compose -f "$GW_HOME/docker-compose.yml" --project-directory "$GW_HOME" "$@"
}

own() {
  if [ "$(id -u)" -ne 0 ]; then
    return 0
  fi
  chown -R 1000:1000 "$1"
}

folder_dir() {
  printf '%s/%s' "$FOLDERS_DIR" "$1"
}

ensure_folder_dir() {
  efd=$(folder_dir "$1")
  mkdir -p "$efd/.stfolder"
  own "$efd"
}

load_approved() {
  if [ -s "$APPROVED" ]; then
    cat "$APPROVED"
  else
    printf '[]'
  fi
}

dev_objs() {
  printf '%s' "$1" | jq -c 'map({deviceID: .})'
}

ensure_folder() {
  if st_api GET "/rest/config/folders/$1" > /dev/null 2>&1; then
    return 0
  fi
  ensure_folder_dir "$1"
  put_folder "$1" "$2" "/var/syncthing/$1" "$3" "$(dev_objs "$4")"
}

set_folder_devices() {
  sd_body=$(jq -nc --argjson d "$(dev_objs "$2")" '{devices: $d}')
  st_api PATCH "/rest/config/folders/$1" "$sd_body" > /dev/null
}

publish_peers() {
  pp_list=$(load_approved)
  if [ "$(printf '%s' "$pp_list" | jq 'length')" -eq 0 ]; then
    log WARN "no nodes left, peers.json not changed"
    return 0
  fi
  ensure_folder_dir tinycloud-peers
  pp_dir=$(folder_dir tinycloud-peers)
  pp_links=$(load_links)
  printf '%s' "$pp_list" | jq -c --argjson l "$pp_links" \
    "{version: 1, peers: (map({id, name, role, owner}) + (\$l | $LINK_PEERS)), links: (\$l | map({host, relay_id, disc_id, token}))}" > "$pp_dir/.syncthing.peers.json.tmp"
  mv "$pp_dir/.syncthing.peers.json.tmp" "$pp_dir/peers.json"
  own "$pp_dir"
  if ! st_api POST "/rest/db/scan?folder=tinycloud-peers" > /dev/null; then
    log WARN "could not trigger a scan, it will be picked up shortly"
  fi
}

sync_shared_folders() {
  ss_gw=$1
  ss_list=$2
  ss_all=$(printf '%s' "$ss_list" | jq -c --arg gw "$ss_gw" '[$gw] + map(.id)')
  ensure_folder tinycloud-peers "TinyCloud Peers" sendonly "$(jq -nc --arg gw "$ss_gw" '[$gw]')" || return 1
  set_folder_devices tinycloud-peers "$ss_all"
}

sync_view_folder() {
  sv_gw=$1
  sv_list=$2
  sv_owner=$3
  sv_ids=$(printf '%s' "$sv_list" | jq -c --arg gw "$sv_gw" --arg o "$sv_owner" '[$gw] + [.[] | select(.owner == $o) | .id]')
  if [ "$(printf '%s' "$sv_ids" | jq 'length')" -le 1 ]; then
    st_api DELETE "/rest/config/folders/tc-view-$sv_owner" > /dev/null 2>&1 || true
    return 0
  fi
  ensure_folder "tc-view-$sv_owner" "TinyCloud View" sendonly "$(jq -nc --arg gw "$sv_gw" '[$gw]')" || return 1
  set_folder_devices "tc-view-$sv_owner" "$sv_ids"
}

do_approve() {
  ap_n=0
  ap_name=
  ap_id=
  ap_role=
  ap_owner=
  for ap_arg in "$@"; do
    case $ap_arg in
      --yes) ASSUME_YES=1 ;;
      *)
        ap_n=$((ap_n + 1))
        case $ap_n in
          1) ap_name=$ap_arg ;;
          2) ap_id=$ap_arg ;;
          3) ap_role=$ap_arg ;;
          4) ap_owner=$ap_arg ;;
        esac
        ;;
    esac
  done
  if [ "$ap_n" -ne 4 ]; then
    usage
    return 1
  fi
  valid_name "$ap_name" || { log ERROR "bad node name"; return 1; }
  valid_device_id "$ap_id" || { log ERROR "bad device id"; return 1; }
  valid_role "$ap_role" || { log ERROR "bad role, use anchor, contributor, partial, or reader"; return 1; }
  valid_name "$ap_owner" || { log ERROR "bad owner name"; return 1; }
  ap_list=$(load_approved)
  if [ "$(printf '%s' "$ap_list" | jq --arg n "$ap_name" 'any(.[]; .name == $n)')" = true ]; then
    log ERROR "a node named $ap_name already exists"
    return 1
  fi
  if [ "$(printf '%s' "$ap_list" | jq --arg i "$ap_id" 'any(.[]; .id == $i)')" = true ]; then
    log ERROR "that device id is already approved"
    return 1
  fi
  if [ "$(printf '%s' "$ap_list" | jq 'length')" -ge 64 ]; then
    log ERROR "limit of 64 nodes reached"
    return 1
  fi
  ap_gw=$(st_api GET /rest/system/status | jq -r '.myID // empty')
  valid_device_id "$ap_gw" || { log ERROR "cannot read the gateway id"; return 1; }
  if [ "$ap_id" = "$ap_gw" ]; then
    log ERROR "that is the gateway's own id"
    return 1
  fi
  printf 'Node: %s\nRole: %s\nOwner: %s\nVerification code: %s\n' "$ap_name" "$ap_role" "$ap_owner" "$(verify_code "$ap_id")"
  printf 'The node status page must show the same code.\n'
  confirm || { echo "cancelled"; return 1; }
  ap_new=$(printf '%s' "$ap_list" | jq -c --arg n "$ap_name" --arg i "$ap_id" --arg r "$ap_role" --arg o "$ap_owner" '. + [{name: $n, id: $i, role: $r, owner: $o}]')
  ap_fail="approve failed, nothing was published. run it again, or tinycloud-gw remove $ap_name to clean up"
  put_device "$ap_id" "$ap_name" '["dynamic"]' || { log ERROR "$ap_fail"; return 1; }
  sync_shared_folders "$ap_gw" "$ap_new" || { log ERROR "$ap_fail"; return 1; }
  ensure_folder "tc-status-$ap_name" "TinyCloud Status" receiveonly "$(jq -nc --arg a "$ap_gw" --arg b "$ap_id" '[$a, $b]')" || { log ERROR "$ap_fail"; return 1; }
  sync_view_folder "$ap_gw" "$ap_new" "$ap_owner" || { log ERROR "$ap_fail"; return 1; }
  write_atomic "$APPROVED" "$ap_new"
  publish_peers
  audit "approve $ap_name $ap_id $ap_role $ap_owner"
  log INFO "approved $ap_name"
}

do_remove() {
  rm_name=
  for rm_arg in "$@"; do
    case $rm_arg in
      --yes) ASSUME_YES=1 ;;
      *) rm_name=$rm_arg ;;
    esac
  done
  valid_name "$rm_name" || { usage; return 1; }
  rm_list=$(load_approved)
  rm_entry=$(printf '%s' "$rm_list" | jq -c --arg n "$rm_name" '.[] | select(.name == $n)')
  if [ -z "$rm_entry" ]; then
    log ERROR "no node named $rm_name"
    return 1
  fi
  rm_id=$(printf '%s' "$rm_entry" | jq -r '.id')
  rm_owner=$(printf '%s' "$rm_entry" | jq -r '.owner')
  printf 'Remove node %s (owner %s). Its device is dropped and the others stop syncing with it.\n' "$rm_name" "$rm_owner"
  confirm || { echo "cancelled"; return 1; }
  rm_gw=$(st_api GET /rest/system/status | jq -r '.myID // empty')
  valid_device_id "$rm_gw" || { log ERROR "cannot read the gateway id"; return 1; }
  rm_new=$(printf '%s' "$rm_list" | jq -c --arg n "$rm_name" 'map(select(.name != $n))')
  write_atomic "$APPROVED" "$rm_new"
  publish_peers
  if [ "$(printf '%s' "$rm_new" | jq 'length')" -gt 0 ]; then
    sync_shared_folders "$rm_gw" "$rm_new" || log WARN "could not update the peers folder"
  fi
  sync_view_folder "$rm_gw" "$rm_new" "$rm_owner" || log WARN "could not update the view folder"
  st_api DELETE "/rest/config/folders/tc-status-$rm_name" > /dev/null 2>&1 || log WARN "status folder was already gone"
  st_api DELETE "/rest/config/devices/$rm_id" > /dev/null 2>&1 || log WARN "device was already gone"
  rm -rf "$(folder_dir "tc-status-$rm_name")"
  audit "remove $rm_name $rm_id"
  log INFO "removed $rm_name"
}

cmd_list() {
  ls_list=$(load_approved)
  if [ "$(printf '%s' "$ls_list" | jq 'length')" -eq 0 ]; then
    echo "no nodes yet"
    return 0
  fi
  ls_conns=$(st_api GET /rest/system/connections 2> /dev/null || printf '{}')
  printf '%s' "$ls_list" | jq -r --argjson c "$ls_conns" \
    '.[] | [.name, .role, .owner, (if ($c.connections // null) == null then "?" elif $c.connections[.id].connected == true then "online" else "offline" end), .id[0:7]] | @tsv' |
    awk -F '\t' 'BEGIN {printf "%-20s %-12s %-16s %-8s %s\n", "NAME", "ROLE", "OWNER", "STATE", "ID"} {printf "%-20s %-12s %-16s %-8s %s\n", $1, $2, $3, $4, $5}'
}

node_status() {
  ns_file=$(folder_dir "tc-status-$1")/status.json
  if [ ! -r "$ns_file" ] || [ "$(wc -c < "$ns_file")" -gt 2048 ]; then
    printf 'null'
    return 0
  fi
  ns_out=$(jq -c '
    select(.v == 1
      and (.version | type == "string" and test("^[A-Za-z0-9._-]{1,32}$"))
      and (.percent_stored | type == "number" and . >= 0 and . <= 100 and . == floor)
      and (.free_bytes | type == "number" and . >= 0)
      and (.low_space | type == "boolean")
      and (.case_conflicts | type == "number" and . >= 0 and . == floor)
      and (.time | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
      and (.booted == null or (.booted | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")))
      and (.reboot_required == null or (.reboot_required | type == "boolean")))
    | {version, percent_stored, free_bytes, low_space, case_conflicts, reported: .time, booted: (.booted // null), reboot_required: (.reboot_required // false)}' "$ns_file" 2> /dev/null)
  if [ -n "$ns_out" ]; then
    printf '%s' "$ns_out"
  else
    printf 'null'
  fi
}

build_nodes() {
  bn_list=$(load_approved)
  bn_conns=$(st_api GET /rest/system/connections 2> /dev/null || printf '{}')
  bn_out='[]'
  for bn_name in $(printf '%s' "$bn_list" | jq -r '.[].name'); do
    bn_status=$(node_status "$bn_name")
    bn_entry=$(printf '%s' "$bn_list" | jq -c --arg n "$bn_name" --argjson c "$bn_conns" --argjson s "$bn_status" '
      .[] | select(.name == $n)
      | {name, role, owner,
         online: (if ($c.connections // null) == null then null else ($c.connections[.id].connected == true) end),
         status: $s}')
    bn_out=$(printf '%s' "$bn_out" | jq -c --argjson e "$bn_entry" '. + [$e]')
  done
  printf '%s' "$bn_out"
}

write_view() {
  wv_file=$1
  wv_json=$2
  wv_nodes=$(printf '%s' "$wv_json" | jq -c '.nodes')
  if [ -f "$wv_file" ] && jq -e --argjson n "$wv_nodes" '.nodes == $n' "$wv_file" > /dev/null 2>&1 &&
    [ -n "$(find "$wv_file" -mmin -60 2> /dev/null)" ]; then
    return 0
  fi
  wv_tmp=$(dirname "$wv_file")/.syncthing.$(basename "$wv_file").tmp
  printf '%s\n' "$wv_json" > "$wv_tmp" && mv "$wv_tmp" "$wv_file"
  own "$wv_file"
}

do_aggregate() {
  ag_nodes=$(build_nodes)
  ag_full=$(jq -nc --arg g "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson n "$ag_nodes" '{version: 1, generated: $g, nodes: $n}')
  mkdir -p "$GW_STATE"
  write_view "$GW_STATE/view.json" "$ag_full"
  date +%s > "$GW_STATE/aggregated.at"
  for ag_owner in $(printf '%s' "$ag_nodes" | jq -r '[.[].owner] | unique | .[]'); do
    ag_dir=$(folder_dir "tc-view-$ag_owner")
    if [ -d "$ag_dir" ]; then
      write_view "$ag_dir/view.json" "$(printf '%s' "$ag_full" | jq -c --arg o "$ag_owner" '.nodes |= map(select(.owner == $o))')"
    fi
  done
  run_alerts || true
  run_heartbeat || true
}

cmd_aggregate() {
  lock > /dev/null 2>&1 || return 0
  do_aggregate
  ag_rc=$?
  unlock
  return $ag_rc
}

cmd_view() {
  if [ ! -s "$GW_STATE/view.json" ]; then
    cmd_aggregate || return 1
  fi
  cv_at=$(cat "$GW_STATE/aggregated.at" 2> /dev/null)
  case $cv_at in
    '' | *[!0-9]*) cat "$GW_STATE/view.json" ;;
    *) jq -c --argjson t "$cv_at" '.generated = ($t | todate)' "$GW_STATE/view.json" ;;
  esac
}

STATUS_JQ='
  def age: if . < 0 then "-" elif . < 60 then "just now" elif . < 3600 then "\((. / 60 | floor)) min ago" elif . < 172800 then "\((. / 3600 | floor)) hr ago" else "\((. / 86400 | floor)) days ago" end;
  def dur: if . < 0 then "-" elif . < 3600 then "\([(. / 60 | floor), 1] | max) min" elif . < 172800 then "\((. / 3600 | floor)) hr" else "\((. / 86400 | floor)) days" end;
  def uptime: if .online == false or (.status.booted // null) == null then "-" else ((now - (.status.booted | fromdateiso8601)) | floor | dur) end;
  def warnings:
    [ (if .online == false then "Offline" else empty end),
      (if .status == null then "No status yet"
       else
         (if .status.low_space then "Low space" else empty end),
         (if .status.case_conflicts > 0 then "\(.status.case_conflicts) name conflict" + (if .status.case_conflicts == 1 then "" else "s" end) else empty end),
         (if (.status.reboot_required // false) then "Reboot needed" else empty end),
         (if (now - (.status.reported | fromdateiso8601)) > 129600 then "Stale status" else empty end)
       end) ] | join(", ");
  .nodes | sort_by([.owner, .name])[]
  | [ .name, .owner, .role,
      (if .online == true then "Online" elif .online == false then "Offline" else "Unknown" end),
      uptime,
      (if .status == null then "-" else "\(.status.percent_stored)%" end),
      (if .status == null then "-" else (.status.free_bytes | tostring) end),
      (.status.version // "-"),
      (if .status == null then "-" else ((now - (.status.reported | fromdateiso8601)) | floor | age) end),
      warnings ]
  | @tsv'

render_status() {
  rs_view=$1
  rs_color=$2
  rs_gen=$(printf '%s' "$rs_view" | jq -r '(now - (.generated | fromdateiso8601)) | floor' 2> /dev/null) || return 1
  printf '%s' "$rs_view" | jq -r "$STATUS_JQ" | awk -F '\t' -v gen="$rs_gen" -v color="$rs_color" '
    function age(s) {
      if (s < 60) return "just now"
      if (s < 3600) return int(s / 60) " min ago"
      if (s < 172800) return int(s / 3600) " hr ago"
      return int(s / 86400) " days ago"
    }
    function paint(line,   e) {
      if (color != "1") return line
      e = sprintf("%c", 27)
      gsub(/Online/, e "[32m&" e "[0m", line)
      gsub(/Offline/, e "[31m&" e "[0m", line)
      gsub(/Low space/, e "[31m&" e "[0m", line)
      gsub(/No status yet|Stale status|[0-9]+ name conflicts?/, e "[33m&" e "[0m", line)
      return line
    }
    BEGIN {
      split("NODE OWNER ROLE STATE UPTIME STORED FREE VERSION CHANGED WARNINGS", head, " ")
      for (i = 1; i <= 10; i++) w[i] = length(head[i])
    }
    {
      n++
      if ($7 != "-") $7 = sprintf("%.1f GB", $7 / 1073741824)
      for (i = 1; i <= 10; i++) {
        row[n, i] = $i
        if (length($i) > w[i]) w[i] = length($i)
      }
      if ($4 == "Online") up++
      if ($10 != "") warn++
    }
    END {
      if (n == 0) {
        print "No nodes yet."
        exit
      }
      printf "TinyCloud: %d node%s, %d online, %d with warnings. Updated %s.\n\n", n, (n == 1 ? "" : "s"), up, warn, age(gen)
      line = ""
      for (i = 1; i <= 10; i++) line = line sprintf("%-" w[i] "s  ", head[i])
      sub(/ +$/, "", line)
      print line
      for (r = 1; r <= n; r++) {
        line = ""
        for (i = 1; i <= 10; i++) line = line sprintf("%-" w[i] "s  ", row[r, i])
        sub(/ +$/, "", line)
        print paint(line)
      }
    }'
}

status_once() {
  so_view=$(cmd_view) || return 1
  render_status "$so_view" "$1"
}

watch_status() {
  ws_wait=${GW_WATCH_INTERVAL:-10}
  while true; do
    cmd_aggregate > /dev/null 2>&1
    ws_out=$(status_once "$1") || ws_out="Could not read the status view."
    printf '\033[H\033[2J%s\n\nRefreshing every %s seconds. Press Ctrl+C to stop.\n' "$ws_out" "$ws_wait"
    sleep "$ws_wait"
  done
}

cmd_status() {
  cs_color=0
  cs_watch=0
  for cs_arg in "$@"; do
    case $cs_arg in
      --color) cs_color=1 ;;
      --watch) cs_watch=1 ;;
      *)
        usage
        return 1
        ;;
    esac
  done
  if [ "$cs_watch" = 1 ]; then
    [ -t 1 ] && cs_color=1
    watch_status "$cs_color"
    return $?
  fi
  status_once "$cs_color"
}

cmd_config() {
  if [ ! -r "$GW_HOME/node-lines.txt" ]; then
    log ERROR "no saved node settings found, run gateway.sh first"
    return 1
  fi
  cat "$GW_HOME/node-lines.txt"
}

backup_paths() {
  for bp_item in .env node-lines.txt alerts.conf state data/syncthing/config data/relay data/disco/cert.pem data/disco/key.pem audit.log; do
    if [ -e "$GW_HOME/$bp_item" ]; then
      printf '%s\n' "$bp_item"
    fi
  done
}

backup_fail() {
  log ERROR "$1"
  if [ "$bk_auto" = 1 ]; then
    alert_send "TinyCloud: the weekly gateway backup failed on $(hostname): $1" || true
  fi
  return 1
}

cmd_backup() {
  bk_auto=0
  [ "${1:-}" = --auto ] && bk_auto=1
  bk_paths=$(backup_paths)
  if [ -z "$bk_paths" ]; then
    backup_fail "nothing to back up in $GW_HOME"
    return 1
  fi
  (umask 077 && mkdir -p "$BACKUP_DIR") || { backup_fail "could not create $BACKUP_DIR"; return 1; }
  chmod 700 "$BACKUP_DIR"
  bk_out="$BACKUP_DIR/tinycloud-gateway-$(date +%Y%m%d-%H%M%S).tar.gz"
  if ! printf '%s\n' "$bk_paths" | (umask 077 && tar czf "$bk_out" --exclude='data/syncthing/config/index-*' -C "$GW_HOME" -T -); then
    rm -f "$bk_out"
    backup_fail "could not write the backup"
    return 1
  fi
  chmod 600 "$bk_out"
  bk_old=$(find "$BACKUP_DIR" -maxdepth 1 -name 'tinycloud-gateway-*.tar.gz' | sort -r | tail -n +11)
  for bk_file in $bk_old; do
    rm -f "$bk_file"
  done
  audit "backup $bk_out"
  printf 'Saved: %s\n' "$bk_out"
  if [ "$bk_auto" = 1 ]; then
    return 0
  fi
  bk_host=$(sed -n 's/^GATEWAY_HOST=//p' "$GW_HOME/.env" 2> /dev/null | tail -n 1)
  printf 'It holds secrets. Copy it off this server, for example:\n  scp root@%s:%s .\n' "${bk_host:-GATEWAY}" "$bk_out"
}

safe_archive() {
  sa_list=$(tar tzf "$1" 2> /dev/null) || return 1
  if printf '%s\n' "$sa_list" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    return 1
  fi
  printf '%s\n' "$sa_list" | grep -Eq '^(\./)?data/syncthing/config/config\.xml$'
}

do_restore() {
  rs_file=
  for rs_arg in "$@"; do
    case $rs_arg in
      --yes) ASSUME_YES=1 ;;
      *) rs_file=$rs_arg ;;
    esac
  done
  if [ -z "$rs_file" ] || [ ! -f "$rs_file" ]; then
    usage
    return 1
  fi
  if ! safe_archive "$rs_file"; then
    log ERROR "that file is not a valid gateway backup"
    return 1
  fi
  echo "This replaces the gateway identity on this server with the backup."
  confirm || { echo "cancelled"; return 1; }
  dc down || { log ERROR "could not stop the stack"; return 1; }
  find "$GW_STATE" -mindepth 1 -maxdepth 1 ! -name .lock -exec rm -rf {} + 2> /dev/null
  rm -f "$GW_HOME/alerts.conf"
  tar xzf "$rs_file" -C "$GW_HOME" || { log ERROR "could not unpack the backup"; return 1; }
  own "$GW_HOME/data"
  ensure_folder_dir tinycloud-peers
  rs_list=$(load_approved)
  for rs_name in $(printf '%s' "$rs_list" | jq -r '.[].name'); do
    ensure_folder_dir "tc-status-$rs_name"
  done
  for rs_owner in $(printf '%s' "$rs_list" | jq -r '[.[].owner] | unique | .[]'); do
    ensure_folder_dir "tc-view-$rs_owner"
  done
  dc up -d || { log ERROR "could not start the stack"; return 1; }
  st_wait 90 || return 1
  publish_peers
  audit "restore $rs_file"
  log INFO "restored"
}

replace_token() {
  rp_file=$1
  rp_tmp=$rp_file.tmp
  [ -f "$rp_file" ] || return 0
  (umask 077 && sed "s/^RELAY_TOKEN=.*/RELAY_TOKEN=$2/" "$rp_file" > "$rp_tmp") && mv "$rp_tmp" "$rp_file"
}

do_rotate_token() {
  for rt_arg in "$@"; do
    case $rt_arg in
      --yes) ASSUME_YES=1 ;;
      *)
        usage
        return 1
        ;;
    esac
  done
  if [ ! -f "$GW_HOME/.env" ]; then
    log ERROR "no gateway settings found, run setup.sh first"
    return 1
  fi
  printf 'Make a new relay token. Nodes cannot use the relay until each one gets the new token.\n'
  confirm || { echo "cancelled"; return 1; }
  rt_token=$(gen_token)
  valid_token "$rt_token" || { log ERROR "could not make a token"; return 1; }
  replace_token "$GW_HOME/.env" "$rt_token" || { log ERROR "could not save the new token"; return 1; }
  replace_token "$GW_HOME/node-lines.txt" "$rt_token" || log WARN "could not update node-lines.txt"
  dc up -d --force-recreate relay > /dev/null 2>&1 || { log ERROR "could not restart the relay"; return 1; }
  audit "rotate-token"
  log INFO "relay token changed"
  printf '\nNew token (secret):\n\nRELAY_TOKEN=%s\n\n' "$rt_token"
  printf 'On each node, update it with:  tinycloud relay-token\n'
  printf 'Older backups hold the old token. Make a new one now with:  tinycloud-gw backup\n'
}

cmd_rotate_token() { locked do_rotate_token "$@"; }

cmd_approve() { locked do_approve "$@"; }
cmd_remove() { locked do_remove "$@"; }
cmd_restore() { locked do_restore "$@"; }

main() {
  require_root || return 1
  mc_cmd=${1:-help}
  [ $# -gt 0 ] && shift
  case $mc_cmd in
    approve) cmd_approve "$@" ;;
    remove) cmd_remove "$@" ;;
    list) cmd_list ;;
    link) cmd_link "$@" ;;
    config) cmd_config ;;
    aggregate) cmd_aggregate ;;
    view) cmd_view ;;
    status) cmd_status "$@" ;;
    alert) cmd_alert "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    rotate-token) cmd_rotate_token "$@" ;;
    version) echo "$GW_VERSION" ;;
    help | -h | --help) usage ;;
    *)
      usage
      return 1
      ;;
  esac
}

if [ "${GW_NO_MAIN:-}" != 1 ]; then
  main "$@"
fi
